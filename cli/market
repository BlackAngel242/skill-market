#!/usr/bin/env bash
#
# market - installe et met à jour des skills depuis le marketplace skill-market.
#
#   market list                catalogue distant
#   market search <mot>        recherche dans le catalogue
#   market info <skill>        fiche d'un skill
#   market install <skill> [--force] [-y]  installe en global
#   market upgrade <skill> [--force]  met à jour un skill installé
#   market update              met à jour tous les skills installés
#   market remove <skill>      désinstalle
#   market installed           skills installés localement
#   market doctor              diagnostic en lecture seule
#   market publish [chemin]    valide un skill avant soumission (PR)
#
# Variables d'environnement :
#   MARKET_REPO    dépôt GitHub (défaut : BlackAngel242/skill-market)
#   MARKET_BRANCH  branche (défaut : main)
#   MARKET_HOME    dossier d'installation (défaut : ~/.skill-market)
#
set -euo pipefail

REPO="${MARKET_REPO:-BlackAngel242/skill-market}"
BRANCH="${MARKET_BRANCH:-main}"
MARKET_HOME="${MARKET_HOME:-$HOME/.skill-market}"
SKILLS_DIR="$MARKET_HOME/skills"
INDEX_URL="https://raw.githubusercontent.com/${REPO}/${BRANCH}/index.json"
REPO_URL="https://github.com/${REPO}.git"

export PYTHONIOENCODING=utf-8
# Sous Windows, python3 peut être l'alias Microsoft Store, qui ne lance rien : garder le premier interpréteur qui répond.
PY=""
for cand in python3 python; do
  if "$cand" -c 'import sys; sys.exit(sys.version_info < (3,))' >/dev/null 2>&1; then PY="$cand"; break; fi
done

need_python() {
  [ -n "$PY" ] || { echo "Outil manquant : Python 3 (python3 ou python). Installe-le puis relance." >&2; exit 1; }
}

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Outil manquant : '$1'. Installe-le puis relance." >&2; exit 1; }
}

ask() {
  # ask "question" -> 0 si oui
  local prompt="$1"
  if [ "${ASSUME_YES:-0}" = "1" ]; then return 0; fi
  read -r -p "$prompt [o/N] " ans
  [[ "$ans" =~ ^[oOyY]$ ]]
}

fetch_index() { need curl; curl -fsSL "$INDEX_URL"; }

# usage: skill_field <nom> <champ>  -> imprime le champ du skill dans index.json
valid_skill_name() {
  [[ "${1:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "${1:-}" != "." && "${1:-}" != ".." ]]
}

valid_skill_path() {
  local path="${1:-}" part
  [[ "$path" == skills/* && "$path" != *\\* ]] || return 1
  local -a parts
  IFS=/ read -r -a parts <<< "$path"
  (("${#parts[@]}" >= 2)) || return 1
  for part in "${parts[@]}"; do
    [[ -n "$part" && "$part" != "." && "$part" != ".." ]] || return 1
  done
}

require_skill_name() {
  valid_skill_name "${1:-}" || { echo "Nom de skill invalide." >&2; return 1; }
}

skill_field() {
  local name="$1" field="$2"
  fetch_index | "$PY" -c '
import json, sys
name, field = sys.argv[1:3]
for s in json.load(sys.stdin)["skills"]:
    if s["name"] == name:
        print(s.get(field, ""))
        break
' "$name" "$field"
}

ver_newer() {
  # ver_newer <installée> <distante> -> 0 si distante plus récente
  [ "$1" = "$2" ] && return 1
  local top; top=$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)
  [ "$top" = "$2" ]
}

download_skill() {
  # download_skill <chemin-dans-le-repo> <dossier-destination>
  local spath="$1" dest="$2" tmp
  tmp=$(mktemp -d)
  if command -v git >/dev/null 2>&1; then
    git -C "$tmp" clone -q --branch "$BRANCH" --depth 1 --filter=blob:none --sparse "$REPO_URL" repo || { rm -rf "$tmp"; return 1; }
    git -C "$tmp/repo" sparse-checkout set "$spath" >/dev/null || { rm -rf "$tmp"; return 1; }
    cp -r "$tmp/repo/$spath" "$dest" || { rm -rf "$tmp"; return 1; }
  else
    need curl; need tar
    curl -fsSL "https://github.com/${REPO}/archive/refs/heads/${BRANCH}.tar.gz" | tar -xz -C "$tmp" || { rm -rf "$tmp"; return 1; }
    cp -r "$tmp"/skill-market-"$BRANCH"/"$spath" "$dest" || { rm -rf "$tmp"; return 1; }
  fi
  rm -rf "$tmp"
}

check_requires() {
  # check_requires <skill.json> : vérifie les outils, propose d'installer ce qui manque
  local manifest="$1"
  need_python
  local missing
  missing=$("$PY" - "$manifest" <<'EOF'
import json, shutil, subprocess, sys
m = json.load(open(sys.argv[1]))
req = m.get("requires", {})
out = []
for b in req.get("bins", []):
    if shutil.which(b) is None:
        out.append("bin:" + b)
npm = req.get("npm", [])
if npm:
    if shutil.which("npm") is None:
        out += ["bin:npm"]
    else:
        for p in npm:
            r = subprocess.run(["npm", "ls", "-g", p], capture_output=True, text=True)
            if r.returncode != 0:
                out.append("npm:" + p)
for p in req.get("pip", []):
    if shutil.which("pip") is None and shutil.which("pip3") is None:
        out.append("bin:pip")
        break
    r = subprocess.run([shutil.which("pip") or shutil.which("pip3"), "show", p], capture_output=True)
    if r.returncode != 0:
        out.append("pip:" + p)
print("\n".join(out))
EOF
) || return 1
  [ -z "$missing" ] && return 0
  echo "Outils requis manquants :"
  local kind pkg
  while IFS= read -r line; do
    kind="${line%%:*}"; pkg="${line#*:}"
    case "$kind" in
      bin)
        echo "  - binaire '$pkg' : installe-le manuellement (apt, brew...), je ne peux pas deviner la source."
        echo "Abandon de l'installation."
        return 1
        ;;
      npm)
        echo "  - paquet npm '$pkg'"
        if ask "Installer '$pkg' en global avec npm ?"; then
          npm install -g "$pkg" || return 1
        else
          echo "Abandon : '$pkg' est requis."
          return 1
        fi
        ;;
      pip)
        echo "  - paquet pip '$pkg'"
        if ask "Installer '$pkg' avec pip ?"; then
          if command -v pip >/dev/null; then pip install "$pkg" || return 1; else pip3 install "$pkg" || return 1; fi
        else
          echo "Abandon : '$pkg' est requis."
          return 1
        fi
        ;;
    esac
  done <<< "$missing"
}

write_installed() {
  local name="$1" version="$2"
  "$PY" -c '
import datetime, json, os, sys
name, version, skills_dir = sys.argv[1:4]
installed = os.path.join(skills_dir, name, "installed.json")
with open(installed, "w", encoding="utf-8") as f:
    json.dump({"name": name, "version": version, "installed_at": datetime.date.today().isoformat()}, f)
' "$name" "$version" "$SKILLS_DIR"
}

do_install() {
  local name="$1" force="${2:-0}" version path iv=untracked tmp dest backup=""
  require_skill_name "$name" || return 1
  need_python
  version=$(skill_field "$name" version) || return 1
  path=$(skill_field "$name" path) || return 1
  [ -n "$version" ] || { echo "Skill '$name' introuvable." >&2; return 1; }
  valid_skill_path "$path" || { echo "Chemin de skill invalide dans le catalogue." >&2; return 1; }
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Version invalide." >&2; return 1; }
  dest="$SKILLS_DIR/$name"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    if [ -f "$dest/installed.json" ]; then
      iv=$("$PY" -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["version"])' "$dest/installed.json") || return 1
      [[ "$iv" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Version installée invalide." >&2; return 1; }
      [ "$iv" != "$version" ] || { echo "$name $version est déjà installé."; return 0; }
    elif [ "$force" != 1 ]; then
      echo "Destination non suivie : $dest. Utilise --force pour sauvegarder et remplacer." >&2; return 1
    fi
  fi
  tmp=$(mktemp -d) || return 1
  if ! download_skill "$path" "$tmp/pkg"; then echo "Téléchargement impossible." >&2; rm -rf -- "$tmp"; return 1; fi
  if ! [ -f "$tmp/pkg/SKILL.md" ] || ! "$PY" -c 'import json,sys; m=json.load(open(sys.argv[1],encoding="utf-8-sig")); assert m.get("name")==sys.argv[2] and m.get("version")==sys.argv[3]' "$tmp/pkg/skill.json" "$name" "$version" || ! check_requires "$tmp/pkg/skill.json"; then
    echo "Skill ou prérequis invalides : installation abandonnée." >&2; rm -rf -- "$tmp"; return 1
  fi
  mkdir -p "$SKILLS_DIR" "$MARKET_HOME/backup" || { rm -rf -- "$tmp"; return 1; }
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    backup="$MARKET_HOME/backup/$name-$iv-$(date +%Y%m%d%H%M%S)-$$"
    if [ -e "$backup" ] || ! mv -- "$dest" "$backup"; then echo "Sauvegarde impossible." >&2; rm -rf -- "$tmp"; return 1; fi
    echo "Sauvegarde : $backup"
  fi
  if ! cp -r -- "$tmp/pkg" "$dest" || ! write_installed "$name" "$version"; then
    echo "Installation échouée ; restauration de la sauvegarde." >&2
    rm -rf -- "$dest"
    if [ -n "$backup" ] && ! mv -- "$backup" "$dest"; then echo "Restauration impossible : sauvegarde conservée dans $backup" >&2; fi
    rm -rf -- "$tmp"; return 1
  fi
  rm -rf -- "$tmp"
  echo "OK : $name $version installé dans $dest"
}

cmd_list() {
  need_python
  fetch_index | "$PY" -c "
import json, sys
for s in json.load(sys.stdin)['skills']:
    print(s['name'] + ' ' + s['version'] + ' - ' + s.get('description',''))
"
}

cmd_search() {
  need_python
  local q="$1"
  fetch_index | "$PY" -c '
import json, sys
q = sys.argv[1].lower()
for s in json.load(sys.stdin)["skills"]:
    blob = (s["name"] + " " + s.get("description", "")).lower()
    if q in blob:
        print(s["name"] + " " + s["version"] + " - " + s.get("description", ""))
' "$q"
}

cmd_info() {
  need_python
  local name="$1" path manifest
  require_skill_name "$name" || return 1
  path=$(skill_field "$name" path) || return 1
  [ -n "$path" ] && valid_skill_path "$path" || { echo "Skill introuvable ou chemin invalide." >&2; return 1; }
  fetch_index | "$PY" -c 'import json,sys; s=next(x for x in json.load(sys.stdin)["skills"] if x["name"]==sys.argv[1]); print("Nom         :",s["name"]); print("Version     :",s["version"]); print("Auteur      :",s.get("author","-")); print("Description :",s.get("description","-"))' "$name" || return 1
  manifest=$(curl -fsSL "https://raw.githubusercontent.com/${REPO}/${BRANCH}/${path}/skill.json" 2>/dev/null) || manifest=''
  printf '%s' "$manifest" | "$PY" -c 'import json,sys
try:
 m=json.load(sys.stdin); r=m.get("requires"); assert isinstance(m,dict); assert r is None or (isinstance(r,dict) and all(isinstance(v,list) and all(isinstance(x,str) for x in v) for v in r.values()))
 print("Licence     :",m.get("license") or "non renseigné")
 print("Prérequis   :", ("; ".join(k+": "+", ".join(map(str,v)) for k,v in r.items() if isinstance(v,list) and v) or "aucun déclaré") if r is not None else "prérequis inconnus")
except Exception: print("Licence     : non renseigné\nPrérequis   : prérequis inconnus")'
}

cmd_installed() {
  [ -d "$SKILLS_DIR" ] || { echo "Aucun skill installé."; return 0; }
  need_python
  for d in "$SKILLS_DIR"/*/; do
    [ -f "$d/installed.json" ] || continue
    "$PY" -c '
import json, sys
m = json.load(open(sys.argv[1], encoding="utf-8"))
print(m["name"] + " " + m["version"] + " (installé le " + m.get("installed_at", "?") + ")")
' "$d/installed.json"
  done
}

cmd_publish() {
  # cmd_publish [chemin] : valide un skill avant soumission (PR).
  # Vérifie SKILL.md (frontmatter), skill.json (cohérence), l'absence de
  # collision de version dans index.json, l'absence de secrets, la taille.
  local src="${1:-.}"
  [ -d "$src" ] || { echo "Dossier introuvable : $src" >&2; return 1; }
  src=$(cd "$src" && pwd)
  # racine du dépôt (pour index.json) : remonte jusqu'à trouver index.json
  local root="$src"
  while [ "$root" != "/" ] && [ ! -f "$root/index.json" ]; do root=$(dirname "$root"); done
  [ -f "$root/index.json" ] || root=""
  need_python
  "$PY" - "$src" "$root" <<'PYEOF'
import json, os, re, sys

src, root = sys.argv[1], sys.argv[2]
name_dir = os.path.basename(src)
errors, warns, oks = [], [], []

def ok(m): oks.append(m)
def err(m): errors.append(m)
def warn(m): warns.append(m)

# 1. SKILL.md + frontmatter
sk = os.path.join(src, "SKILL.md")
fm = {}
if not os.path.isfile(sk):
    err("SKILL.md manquant")
else:
    txt = open(sk, encoding="utf-8").read()
    m = re.match(r"^---\s*\n(.*?)\n---\s*\n", txt, re.S)
    if not m:
        err("SKILL.md : frontmatter YAML '---' manquant ou malformé")
    else:
        for line in m.group(1).splitlines():
            mm = re.match(r"^\s*([A-Za-z0-9_-]+)\s*:\s*(.+?)\s*$", line)
            if mm: fm[mm.group(1)] = mm.group(2).strip().strip("'\"")
        if fm.get("name"): ok("frontmatter : name = '%s'" % fm["name"])
        else: err("frontmatter : 'name' manquant")
        if fm.get("description"): ok("frontmatter : description présente")
        else: err("frontmatter : 'description' manquante")

# 2. skill.json
sj = os.path.join(src, "skill.json")
manifest = None
if not os.path.isfile(sj):
    err("skill.json manquant")
else:
    try:
        manifest = json.load(open(sj, encoding="utf-8"))
        ok("skill.json : JSON valide")
    except Exception as e:
        err("skill.json : JSON invalide (%s)" % e)

if manifest is not None:
    for f in ("name", "version", "description"):
        if manifest.get(f): ok("skill.json : '%s' présent" % f)
        else: err("skill.json : '%s' manquant" % f)
    n = manifest.get("name", "")
    if n and fm.get("name") and n != fm["name"]:
        err("incohérence : skill.json name='%s' != SKILL.md name='%s'" % (n, fm["name"]))
    elif n: ok("skill.json : name cohérent avec SKILL.md")
    if n and n != name_dir:
        err("incohérence : skill.json name='%s' != nom du dossier '%s'" % (n, name_dir))
    elif n: ok("skill.json : name cohérent avec le dossier")
    v = str(manifest.get("version", ""))
    if re.match(r"^\d+\.\d+\.\d+$", v): ok("skill.json : version '%s' valide (semver)" % v)
    elif v: err("skill.json : version '%s' invalide (attendu X.Y.Z)" % v)

# 3. index.json : collision de version
if root and manifest:
    try:
        idx = json.load(open(os.path.join(root, "index.json"), encoding="utf-8"))
        names = {s["name"]: s.get("version", "") for s in idx.get("skills", [])}
        n, v = manifest.get("name", ""), str(manifest.get("version", ""))
        if n in names:
            if names[n] == v:
                err("index.json : la version %s de '%s' est déjà publiée (bumpe la version)" % (v, n))
            else:
                ok("index.json : '%s' existe (%s), nouvelle version %s" % (n, names[n], v))
        else:
            ok("index.json : '%s' est un nouveau skill (aucune collision)" % n)
    except Exception as e:
        warn("index.json illisible : %s" % e)

# 4. scan secrets (avertissement, revue manuelle)
pats = [r"sk-[A-Za-z0-9]{20,}", r"ghp_[A-Za-z0-9]{20,}", r"BEGIN [A-Z ]*PRIVATE KEY",
        r"(?i)(api[_-]?key|secret|token)\s*[:=]\s*['\"][^'\"]{8,}['\"]"]
hits = []
for dp, _, fns in os.walk(src):
    if ".git" in dp.split(os.sep): continue
    for fn in fns:
        p = os.path.join(dp, fn)
        try:
            t = open(p, encoding="utf-8", errors="ignore").read()
        except Exception:
            continue
        for pat in pats:
            for m in re.finditer(pat, t):
                hits.append("%s: %s..." % (os.path.relpath(p, src), m.group(0)[:24]))
                break
if hits:
    warn("possible secret détecté (%d) : %s — vérifie avant de publier" % (len(hits), ", ".join(hits[:3])))
else:
    ok("aucun secret détecté")

# 5. taille
total = sum(os.path.getsize(os.path.join(dp, f)) for dp, _, fns in os.walk(src) for f in fns)
if total > 5 * 1024 * 1024:
    warn("skill volumineux : %.1f Mo (> 5 Mo)" % (total / 1048576))
else:
    ok("taille raisonnable : %d Ko" % (total // 1024))

for m in oks: print("  \u2713 " + m)
for m in warns: print("  ! " + m)
for m in errors: print("  \u2717 " + m)
print()
if errors:
    print("RÉSULTAT : %d erreur(s), %d avertissement(s) — corrige avant la PR." % (len(errors), len(warns)))
    sys.exit(1)
print("RÉSULTAT : prêt à publier (%d vérifications, %d avertissement(s))." % (len(oks), len(warns)))
if manifest:
    n, v = manifest.get("name"), manifest.get("version")
    print()
    print("Prochaines étapes :")
    print("  1. Ajoute cette entrée dans index.json :")
    print('     {"name": "%s", "version": "%s", "description": "%s", "author": "BlackAngel242", "path": "skills/%s"}' % (n, v, manifest.get("description", ""), n))
    print("  2. git add skills/%s index.json && git commit -m \"publish: %s %s\"" % (n, n, v))
    print("  3. Ouvre une PR vers main.")
PYEOF
}

cmd_update() {
  need_python
  [ -d "$SKILLS_DIR" ] || { echo "Aucun skill installé."; return 0; }
  local idx n=0 failed=0 d name iv rv
  idx=$(fetch_index) || return 1
  for d in "$SKILLS_DIR"/*/; do
    [ -f "$d/installed.json" ] || continue
    name=$(basename "$d")
    if ! iv=$("$PY" -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["version"])' "$d/installed.json"); then failed=$((failed+1)); continue; fi
    if ! rv=$(printf '%s' "$idx" | "$PY" -c 'import json,sys; print(next((s["version"] for s in json.load(sys.stdin)["skills"] if s["name"]==sys.argv[1]),""))' "$name"); then failed=$((failed+1)); continue; fi
    if [ -n "$rv" ] && ver_newer "$iv" "$rv"; then
      if do_install "$name"; then n=$((n+1)); else failed=$((failed+1)); fi
    fi
  done
  echo "Mises à jour réussies : $n ; échecs : $failed"
  [ "$failed" -eq 0 ]
}

cmd_doctor() {
  local idx rc=0 d name version remote manifest bin
  if [ -z "$PY" ]; then echo "Python 3 : absent"; return 1; fi
  echo "Python 3 : disponible ($PY)"
  if ! idx=$(fetch_index) || ! printf '%s' "$idx" | "$PY" -c 'import json,sys; assert isinstance(json.load(sys.stdin)["skills"],list)' 2>/dev/null; then
    echo "Catalogue inaccessible ou invalide : diagnostic incomplet." >&2; rc=2
  fi
  for d in "$SKILLS_DIR"/*/; do
    [ -d "$d" ] || continue
    name=$(basename "$d")
    if [ ! -f "$d/installed.json" ]; then echo "$name : non suivi"; [ "$rc" -eq 2 ] || rc=1
    else
      version=$("$PY" -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["version"])' "$d/installed.json" 2>/dev/null) || { echo "$name : métadonnées invalides"; [ "$rc" -eq 2 ] || rc=1; version=''; }
      if [ "$rc" -ne 2 ] && [ -n "$version" ]; then
        remote=$(printf '%s' "$idx" | "$PY" -c 'import json,sys; print(next((s["version"] for s in json.load(sys.stdin)["skills"] if s["name"]==sys.argv[1]),""))' "$name" 2>/dev/null) || { echo "Catalogue illisible : diagnostic incomplet."; rc=2; remote=''; }
        if [ "$rc" -ne 2 ]; then
          if [ -z "$remote" ]; then echo "$name : absent du catalogue"; rc=1
          elif ver_newer "$version" "$remote"; then echo "$name : mise à jour disponible ($version -> $remote)"; rc=1
          else echo "$name : à jour ($version ; catalogue $remote)"; fi
        fi
      fi
    fi
    if ! manifest=$("$PY" -c 'import json,sys; m=json.load(open(sys.argv[1],encoding="utf-8-sig")); r=m.get("requires"); assert isinstance(r,dict) and isinstance(r.get("bins",[]),list); print("\n".join(r.get("bins",[])))' "$d/skill.json" 2>/dev/null); then
      echo "$name : prérequis inconnus"; [ "$rc" -eq 2 ] || rc=1; continue
    fi
    while IFS= read -r bin; do
      [ -n "$bin" ] || continue
      if command -v "$bin" >/dev/null 2>&1; then echo "$name : $bin présent"; else echo "$name : $bin manquant"; [ "$rc" -eq 2 ] || rc=1; fi
    done <<< "$manifest"
  done
  return "$rc"
}

usage() {
  sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  list)      cmd_list ;;
  search)    [ $# -ge 2 ] || { echo "Usage : market search <mot>" >&2; exit 1; }; cmd_search "$2" ;;
  info)      [ $# -ge 2 ] || { echo "Usage : market info <skill>" >&2; exit 1; }; cmd_info "$2" ;;
  install|upgrade)
             [ $# -ge 2 ] || { echo "Usage : market $1 <skill> [--force] [-y]" >&2; exit 1; }
             name=$2; shift 2; force=0
             for arg in "$@"; do case "$arg" in -y|--yes) ASSUME_YES=1 ;; --force|-Force) force=1 ;; *) echo "Option inconnue : $arg" >&2; exit 1 ;; esac; done
             do_install "$name" "$force" ;;
  doctor)    cmd_doctor ;;
  update)    cmd_update ;;
  remove)
             [ $# -ge 2 ] || { echo "Usage : market remove <skill>" >&2; exit 1; }
             require_skill_name "$2" || exit 1
             rm -rf -- "$SKILLS_DIR/$2" && echo "$2 désinstallé." ;;
  installed) cmd_installed ;;
  publish)   cmd_publish "${2:-.}" ;;
  -h|--help|help|"") usage ;;
  *) echo "Commande inconnue : $1" >&2; usage >&2; exit 1 ;;
esac
